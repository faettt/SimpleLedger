{
  "$meta": {
    "name": "简账 SimpleLedger · Design Tokens",
    "version": "1.0.0",
    "updated": "2026-09-19",
    "visualDirection": "温和人文派 (Warm Humanist)",
    "platform": "Android 手机 / 折叠屏 / 平板 / 桌面大屏",
    "accessibility": "WCAG 2.2 AA（正文 ≥ 4.5:1）",
    "note": "实测对比度数值见 index.html §09.1；本文件为机器可读副本，供 Compose 主题生成使用。"
  },

  "color": {
    "brand": {
      "brand50":  { "value": "#E4F5F1", "use": "选中态底色 / 高亮区块" },
      "brand100": { "value": "#C9EBE4", "use": "chip 选中 / 徽标" },
      "brand500": { "value": "#12968A", "use": "按压反馈 / 图表主色" },
      "brand600": { "value": "#0F766E", "use": "主品牌色：主按钮 / 选中 / 链接", "contrastOnWarmBg": 5.20 },
      "brand700": { "value": "#0B5F59", "use": "主按钮 hover / 按压" },
      "brand900": { "value": "#073B37", "use": "深色主题容器" }
    },
    "neutral": {
      "bg":         { "value": "#FAF9F7", "use": "页面底色（暖白）" },
      "surface":    { "value": "#FFFFFF", "use": "卡片 / 浮层" },
      "surface2":   { "value": "#F4F1ED", "use": "次级填充：输入框 / chip 底" },
      "surface3":   { "value": "#EDE9E2", "use": "进度条轨道 / 更深一层填充" },
      "line":       { "value": "#E8E4DE", "use": "分隔线 1dp" },
      "lineStrong": { "value": "#D6D0C8", "use": "描边按钮 / 更强分隔" },
      "ink3":       { "value": "#8A837C", "use": "弱化装饰文字（仅 ≥18px）", "contrastOnWarmBg": 3.55, "restriction": "不得用于需阅读的元信息" },
      "ink2":       { "value": "#57534E", "use": "次要文字 / 元信息", "contrastOnWarmBg": 7.25 },
      "ink":        { "value": "#1C1917", "use": "正文 / 金额（暖黑）", "contrastOnWarmBg": 16.62 }
    },
    "semantic": {
      "expense": { "light": "#B84742", "dark": "#EFA79F", "use": "支出金额（暖红，避免警示红制造的焦虑）" },
      "income":  { "light": "#3D7A55", "dark": "#8FCFAA", "use": "收入金额" },
      "warn":    { "light": "#A16207", "dark": "#E0A94A", "use": "预算预警 / 超支" },
      "info":    { "light": "#2B6CB0", "dark": "#8FB8E8", "use": "信息提示" }
    },
    "chart": {
      "palette": ["#0F766E", "#2B6CB0", "#A16207", "#B84742", "#6D5BB8", "#3D7A55", "#B0577F", "#5C6B7A"],
      "darkPalette": ["#6EE7D8", "#7FB3E8", "#E0A94A", "#EFA79F", "#A99BE0", "#8FCFAA", "#E39BBE", "#9DAAB8"],
      "rule": "色相均布、明度接近；红绿不相邻；所有色在白底 ≥ 4.9:1"
    },
    "darkTheme": {
      "bg": "#1A1917", "surface": "#232220", "surface2": "#2C2A26",
      "line": "#3A3731", "ink": "#F5F2EE", "ink2": "#B8B1A9", "brand": "#6EE7D8",
      "rule": "层级靠表面抬升而非阴影；语义色提高明度，正文对比度 ≥ 7.5:1 (AAA)"
    }
  },

  "typography": {
    "family": {
      "sans": "Roboto / Noto Sans CJK（系统无衬线）",
      "serif": "思源宋体（仅启动页、空状态等情绪化场景）",
      "numericRule": "所有金额强制等宽数字 font-variant-numeric: tabular-nums"
    },
    "scale": {
      "display":  { "size": 40, "lineHeight": 44, "weight": 700, "use": "金额输入、空态主数字" },
      "headline": { "size": 28, "lineHeight": 34, "weight": 600, "use": "页面主标题" },
      "titleL":   { "size": 22, "lineHeight": 28, "weight": 600, "use": "区块标题、结余数字" },
      "title":    { "size": 16, "lineHeight": 22, "weight": 600, "use": "卡片标题、列表主信息" },
      "body":     { "size": 15, "lineHeight": 24, "weight": 400, "use": "正文、备注" },
      "bodySm":   { "size": 13.5, "lineHeight": 20, "weight": 400, "use": "密集列表副文本" },
      "label":    { "size": 12.5, "lineHeight": 18, "weight": 600, "letterSpacing": 0.02, "use": "表单标签、按钮" },
      "meta":     { "size": 11.5, "lineHeight": 16, "weight": 400, "use": "时间、分区、笔数等元信息" }
    }
  },

  "spacing": {
    "base": 4,
    "scale": [4, 8, 12, 16, 20, 24, 32, 40, 48],
    "usage": {
      "pageMargin": { "compact": 16, "medium": 24, "expanded": 32 },
      "cardPadding": 20,
      "cardGap": 12,
      "listItemVertical": 10,
      "sectionGap": 24
    }
  },

  "radius": {
    "card": 20,
    "button": 14,
    "input": 14,
    "chip": 999,
    "dialog": 28,
    "iconBubble": 12,
    "rule": "大而收敛：柔和但不胶囊化，避免界面显得幼稚"
  },

  "elevation": {
    "level1": "0 1px 2px rgba(28,25,23,.04), 0 1px 3px rgba(28,25,23,.05)",
    "level2": "0 2px 6px rgba(28,25,23,.05), 0 8px 20px rgba(28,25,23,.06)",
    "level3": "0 12px 34px rgba(28,25,23,.12)",
    "rule": "阴影使用暖色透明黑；深色主题改用表面抬升，几乎不用阴影"
  },

  "motion": {
    "pageTransition": { "duration": 280, "easing": "ease-out" },
    "controlState":   { "duration": 150, "easing": "ease-out" },
    "snackbar":       { "duration": 220, "easing": "ease-in-out" },
    "undoWindow":     { "duration": 4000 },
    "chartDraw":      { "duration": 600, "stagger": 40 },
    "rules": [
      "只动有因果关系的元素，不做装饰动画",
      "不做数字滚动特效（会引起对数值准确性的怀疑）",
      "尊重系统「减少动效」：降级为 0ms 直接切换"
    ]
  },

  "sizeClass": {
    "compact":  { "range": "<600dp",       "navigation": "bottomBar4Slot", "pageMargin": 16, "contentMaxWidth": null, "recordEntry": "fullScreen" },
    "medium":   { "range": "600-840dp",    "navigation": "navigationRail",          "pageMargin": 24, "contentMaxWidth": 640,  "recordEntry": "centeredDialog560" },
    "expanded": { "range": ">=840dp",      "navigation": "navigationRailExpandable","pageMargin": 32, "contentMaxWidth": 1200, "recordEntry": "sidePanel480" },
    "phoneLandscape": { "range": "height<480dp", "navigation": "compactRail", "layout": "twoPane", "recordEntry": "splitPane" }
  },

  "touchTarget": {
    "minimum": 48,
    "minimumGap": 8,
    "listRowHeight": 62,
    "buttonHeights": [44, 52],
    "chipHeight": 34,
    "switch": { "width": 44, "height": 27, "thumb": 21 }
  },

  "navigation": {
    "slots": ["分区", "明细", "统计", "我的"],
    "centerAction": "无（「分区优先」重构后移除中央凸起「记一笔」，同步点 #2）",
    "rationale": "分区升为首屏（默认落点），导航收敛为 4 槽；「记一笔」不再是全局主操作，统一从「分区详情底部」或「明细页先选分区」进入，杜绝任何跳过分区的记账路径",
    "extraPages": ["分区详情", "分区管理", "全局分类管理"]
  }
}
