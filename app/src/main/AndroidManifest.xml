<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        隐私优先：本应用不需要任何**运行时**权限，数据全部保存在本机。
        USE_BIOMETRIC 是 normal 权限，安装即授予、不会向用户弹框；仅用于「应用锁」调用
        BiometricPrompt。截屏保护（FLAG_SECURE）与导出（FileProvider 临时授权）均无需存储权限。

        多端同步（U-2 裁定）：INTERNET / ACCESS_NETWORK_STATE 均为 **normal 权限**（安装即授予、
        无运行时弹窗），仅用于用户自带 WebDAV（坚果云等）的端到端加密同步；
        ACCESS_NETWORK_STATE 仅用于「仅 Wi-Fi 传照片」的网络类型判定（R-17）。
        「零权限」宣传口径据此微调为「零运行时权限」。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".LedgerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SimpleLedger">

        <!--
            configChanges：折叠屏展开/折叠、旋转都是高频且连续的动作（用户展开就是为了继续
            当前操作），默认重建会丢掉输入内容。这些配置项变更时窗口尺寸会变化，Compose 会
            重新计算 BoxWithConstraints 的 maxWidth/maxHeight 并自动重组，深色模式由
            isSystemInDarkTheme() 监听 Configuration 自然生效，无需手工刷新。
            另：editingEntryId 已用 rememberSaveable，即使仍有未覆盖的配置项导致重建，也能恢复。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SimpleLedger">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 导出 CSV / 备份文件时通过 FileProvider 授权给接收方，避免申请存储权限 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
